{
  "name": "@pymoney/core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic PyMoney client: API types, client, money formatting and React Query hooks. No DOM.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../server/docs/openapi.json --output src/generated/openapi.d.ts --immutable --alphabetize",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
