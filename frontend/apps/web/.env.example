# Where the browser finds the API. Default "/api", which Vite proxies in
# development (see vite.config.ts) and which a reverse proxy should map in
# production. Set to an absolute URL to talk to the API cross-origin; then the
# web origin must be listed in the server's PYMONEY_CORS_ORIGINS.
VITE_API_BASE=/api

# Development only: where Vite's /api proxy forwards to.
PYMONEY_API_URL=http://127.0.0.1:8000
