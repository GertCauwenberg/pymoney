# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Frontend (see frontend/.gitignore for the rest)
node_modules/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local environment overrides (never commit secrets)
.env
.env.*
!.env.example

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Real ledgers, including anonymised ones handed over for testing: someone
# else's financial data does not belong in this repository.
*.kmy
*.anon.xml
!tests/fixtures/*.kmy.xml

# Local data
*.sqlite
*.sqlite3
*.db
!tests/**/fixtures/*.sqlite
transcripts/
*.zip
frontend/tmp_file*
