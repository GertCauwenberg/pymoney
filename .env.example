# Copy to .env and edit. .env is gitignored; .env.example is not, so never put
# a real secret here.
#
#   cp .env.example .env

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=pymoney
POSTGRES_USER=pymoney
# Local development only. Generate a real one for anything reachable:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me-local-dev-only
# Created by docker/postgres/initdb.d; the store tests own this database and
# will drop and recreate its schema at will.
POSTGRES_TEST_DB=pymoney_test
# Host port. Bound to 127.0.0.1 by compose.yaml.
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
PYMONEY_API_PORT=8000
PYMONEY_LOG_LEVEL=info
# Session cookies are marked Secure unless this is turned off. Only turn it off
# for plain-HTTP local development.
PYMONEY_COOKIE_SECURE=true
# Open only while setting up the first account, then close it.
PYMONEY_ALLOW_REGISTRATION=false
# Exact origins allowed to send credentialed requests. "*" cannot be combined
# with cookie auth and browsers will reject it.
PYMONEY_CORS_ORIGINS=[]
# Receipts and invoices attached to transactions. The bytes are files on disk,
# not rows in the database: point this at a persistent directory (the compose
# files mount a named volume at /var/lib/pymoney/attachments) and include it in
# your backups next to the database dump. MAX_ATTACHMENT_MB caps one upload.
PYMONEY_MAX_ATTACHMENT_MB=25
# PYMONEY_ATTACHMENTS_DIR=/var/lib/pymoney/attachments
# A bind mount instead of the default named volume, if you prefer:
# PYMONEY_ATTACHMENTS_VOLUME=/srv/pymoney/receipts
# Quote fetching by the API's scheduler: every N minutes, 0 to turn it off.
PYMONEY_QUOTE_INTERVAL_MINUTES=360
# Extra quote providers, JSON list of module:Class references.
PYMONEY_QUOTE_PLUGINS=[]
# Seconds a provider request may take; the ECB is slow on a cold series.
PYMONEY_QUOTE_TIMEOUT=60

# --- Accounts and email -----------------------------------------------------------
# Registering sends an activation link; the account is unusable until it is
# followed, and deleted after a week if it never is.
PYMONEY_REQUIRE_ACTIVATION=true
# Where the links in emails point: the web app's address as users reach it.
PYMONEY_PUBLIC_URL=https://money.example.org
# console (links in the server log), smtp, file or memory.
PYMONEY_MAIL_BACKEND=smtp
PYMONEY_MAIL_FROM=pymoney@example.org
PYMONEY_SMTP_HOST=
PYMONEY_SMTP_PORT=587
PYMONEY_SMTP_USERNAME=
PYMONEY_SMTP_PASSWORD=
PYMONEY_SMTP_STARTTLS=true

# --- Throttling the auth endpoints -------------------------------------------------
# Attempts per minute; 0 turns a limit off. Logins are counted per client
# address and per account; register / forgot-password / resend-activation
# (each may send an email) per client address and per address written to.
PYMONEY_AUTH_RATE_LOGIN_PER_CLIENT=20
PYMONEY_AUTH_RATE_LOGIN_PER_ACCOUNT=5
PYMONEY_AUTH_RATE_MAIL_PER_CLIENT=10
PYMONEY_AUTH_RATE_MAIL_PER_ADDRESS=3
# Behind a reverse proxy every client arrives from the proxy's address. Name
# the header it sets with the real one (the shipped nginx.conf sets this), or
# the whole household shares one bucket. Only set it when a proxy you trust is
# the only way in: a client can write this header too.
PYMONEY_CLIENT_IP_HEADER=X-Forwarded-For
