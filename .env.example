# Copy to .env and edit. .env is gitignored; .env.example is not, so never put
# a real secret here.
#
#   cp .env.example .env

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=pymoney
POSTGRES_USER=pymoney
# Local development only. Generate a real one for anything reachable:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me-local-dev-only
# Created by docker/postgres/initdb.d; the store tests own this database and
# will drop and recreate its schema at will.
POSTGRES_TEST_DB=pymoney_test
# Host port. Bound to 127.0.0.1 by compose.yaml.
POSTGRES_PORT=5432

# --- API (Phase 4, not implemented yet) -----------------------------------
PYMONEY_API_PORT=8000
PYMONEY_LOG_LEVEL=info
