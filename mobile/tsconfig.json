{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./*"],
      "@pymoney/core": ["../frontend/packages/core/src/index.ts"],
      "@pymoney/core/hooks": ["../frontend/packages/core/src/hooks/index.ts"],
      "@pymoney/tokens": ["../frontend/packages/tokens/src/index.ts"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "spike/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
